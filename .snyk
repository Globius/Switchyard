# Snyk policy file. Every entry needs a reason and an expiry; review them when they lapse.
# Policy: docs/security/snyk.md
version: v1.25.0
ignore:
  SNYK-DEBIAN12-ZLIB-6008961:
    - '*':
        reason: >-
          CVE-2023-45853 (zlib MiniZip integer overflow in zipOpenNewFileInZip4_64). Debian 12 marks it
          unfixed / no-DSA. The vulnerable minizip code is not built into the zlib1g runtime library, and
          Patroni and PostgreSQL never create ZIP archives. Revisit when Debian ships a fix.
        expires: 2027-01-16T00:00:00.000Z
        created: 2026-10-16T00:00:00.000Z
