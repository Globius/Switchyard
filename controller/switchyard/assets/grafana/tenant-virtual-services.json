{
  "uid": "sy-tenant-services",
  "title": "Virtual services",
  "tags": [
    "switchyard"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Virtual service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(haproxy_frontend_http_requests_total, proxy)",
          "refId": "svc"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proxy) (rate(haproxy_frontend_http_requests_total{proxy=~\"$service\"}[1m]))",
          "legendFormat": "{{proxy}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proxy) (rate(haproxy_frontend_http_responses_total{proxy=~\"$service\",code=\"5xx\"}[1m])) / clamp_min(sum by (proxy) (rate(haproxy_frontend_http_responses_total{proxy=~\"$service\"}[1m])), 1e-9)",
          "legendFormat": "{{proxy}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Current sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proxy) (haproxy_frontend_current_sessions{proxy=~\"$service\"})",
          "legendFormat": "{{proxy}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bytes out per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proxy) (rate(haproxy_frontend_bytes_out_total{proxy=~\"$service\"}[1m]))",
          "legendFormat": "{{proxy}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Access log",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{frontend=~\"$service\"}"
        }
      ]
    }
  ]
}