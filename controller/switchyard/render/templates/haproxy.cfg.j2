# Managed by Switchyard. Do not edit: changes are reported as drift.
# SE group: {{ group }}
# switchyard-render: sha256:{{ fingerprint }}

global
    log /dev/log local0
    maxconn {{ maxconn }}
{% if stick_counters %}
    tune.stick-counters {{ stick_counters }}
{% endif %}
{% if lua_loads %}
    tune.lua.bool-sample-conversion normal
    httpclient.ssl.ca-file /etc/ssl/certs/ca-certificates.crt
    httpclient.ssl.verify required
    httpclient.resolvers.id sy_dns
    httpclient.resolvers.prefer ipv4
{% for path in lua_loads %}
    lua-load {{ path }}
{% endfor %}
{% endif %}
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-default-server-options ssl-min-ver TLSv1.2

defaults
    log global
    option dontlognull
    option redispatch
    retries 3
    unique-id-format %[uuid()]
    timeout connect 5s
    timeout client 50s
    timeout server 50s
    timeout http-request 10s
    timeout http-keep-alive 10s
    timeout tunnel 1h

{% if peers %}
peers {{ peers.name }}
{% for peer in peers.members %}
    peer {{ peer.name }} {{ peer.target }}
{% endfor %}

{% endif %}
{% if lua_loads %}
resolvers sy_dns
    parse-resolv-conf
    timeout resolve 1s
    timeout retry 1s
    resolve_retries 2

{% endif %}
{% for cache in caches %}
cache {{ cache.name }}
    total-max-size {{ cache.size_mb }}
    max-object-size {{ cache.max_object }}
    max-age {{ cache.max_age }}

{% endfor %}
# Local health endpoint for keepalived's check script and the agent's route-health watchdog.
frontend sy_local_health
    mode http
    bind 127.0.0.1:8404
    monitor-uri /healthz
    no log
{% if exporter %}

# Prometheus exporter, answered only for the management network(s) of the group.
frontend sy_prometheus
    mode http
    bind :{{ exporter.port }}
{% if exporter.v6 %}
    bind [::]:{{ exporter.port }} v6only
{% endif %}
    http-request deny deny_status 403 unless { dst {{ exporter.cidrs | join(" ") }} }
    http-request use-service prometheus-exporter if { path /metrics }
    http-request deny deny_status 404
    no log
{% endif %}
{% for f in frontends %}

{% include "frontend.j2" %}
{% endfor %}
{% if waf_backend %}

{{ waf_backend | join("\n") }}
{% endif %}
{% if crowdsec_backend %}

{{ crowdsec_backend | join("\n") }}
{% endif %}
{% for b in backends %}

{% include "backend.j2" %}
{% endfor %}
