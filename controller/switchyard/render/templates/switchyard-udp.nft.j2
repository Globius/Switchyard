# Managed by Switchyard. Do not edit: changes are reported as drift.
# Source NAT for UDP that IPVS sends to real servers, so replies return through this SE.
{% if v4 %}
table ip sy_udp {
    set backends {
        type ipv4_addr . inet_service
        elements = {
{% for e in v4 %}
            {{ e }}{{ "," if not loop.last }}
{% endfor %}
        }
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip daddr . udp dport @backends masquerade
    }
}
{% endif %}
{% if v6 %}
table ip6 sy_udp {
    set backends {
        type ipv6_addr . inet_service
        elements = {
{% for e in v6 %}
            {{ e }}{{ "," if not loop.last }}
{% endfor %}
        }
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip6 daddr . udp dport @backends masquerade
    }
}
{% endif %}
