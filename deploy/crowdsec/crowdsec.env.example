# Copy to crowdsec.env. Never commit crowdsec.env.
# A private address of this host that the engines and the controller can reach.
CROWDSEC_BIND=
# Host ports (the defaults are the usual ones).
CROWDSEC_API_PORT=8080
CROWDSEC_SYSLOG_PORT=514
# The bouncer key Switchyard uses; generate with `openssl rand -hex 32` and keep it in OpenBao
# (kv/system/crowdsec/bouncer-key, field "value"), the same value you give Switchyard under Admin > Integrations.
CROWDSEC_BOUNCER_KEY=
# true = no signals leave this engine and no community blocklist arrives (the default).
CROWDSEC_DISABLE_ONLINE_API=true
# Only with CROWDSEC_DISABLE_ONLINE_API=false: the console enrollment key from app.crowdsec.net (a credential).
CROWDSEC_ENROLL_KEY=
CROWDSEC_INSTANCE_NAME=switchyard
