# Copy to dns.env.  openssl rand -hex 32
PDNS_API_KEY=change-me
# Addresses that may call the API (the controller nodes), comma separated.
PDNS_API_ALLOW_FROM=10.0.0.11,10.0.0.12,10.0.0.13
# Where DNS answers (default: everywhere) and where the API listens (default: loopback).
DNS_BIND=0.0.0.0
PDNS_API_BIND=10.0.0.20
