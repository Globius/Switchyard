# Copy to hosts.env and fill in. Everything the hosts lab needs to know about your Proxmox hosts.
# The Proxmox API (any cluster node answers for the whole cluster).
PVE_URL=https://pve1.lab.example:8006
PVE_TOKEN_ID=switchyard@pve!controller
PVE_TOKEN_SECRET=
# Proxmox root CA (/etc/pve/pve-root-ca.pem from a node), saved on this machine.
PVE_CA_FILE=./pve-root-ca.pem
# Node names exactly as Proxmox shows them, and how to ssh to each as root (key-based, no password prompt).
NODES="pve1 pve2"
SSH_pve1=root@192.168.50.11
SSH_pve2=root@192.168.50.12
# The three lab networks, as SDN VNets or bridges that exist on both nodes (prep-host.sh --sdn creates VLAN VNets).
VNET_MGMT=labmgmt
VNET_VIP=labvip
VNET_BACKEND=labbe
# Template ids: TEMPLATE_BASE + 10 per node (first node 0, second 10) + 1 container, 2 VM, 3 unprivileged container.
# With the default 9960: pve1 has 9961 / 9962 / 9963 and pve2 has 9971 / 9972 / 9973. Each node needs its own templates
# (local storage), and the lab deploys to a node from that node's template. The helper guest uses 9970 on the first node.
TEMPLATE_BASE=9960
# Address of THIS machine on the management network (engines enroll to https://<this>:8443; it must be routed there).
CONTROLLER_ADDR=172.30.0.5
# Storage for VM disks and an address the VM build can reach this node on (see se-image/kvm/build-template.sh).
VM_STORAGE=local-lvm
