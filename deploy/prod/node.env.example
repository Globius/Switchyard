# Per-node settings. Copy to node.env (never commit it). Secrets belong in OpenBao; these bootstrap the first start.
NODE_NAME=ctl-1
NODE_IP=10.0.0.11
ETCD_INITIAL_CLUSTER=ctl-1=https://10.0.0.11:2380,ctl-2=https://10.0.0.12:2380,ctl-3=https://10.0.0.13:2380
# The three controller nodes: the only sources pg_hba admits, and the firewall (firewall.sh) lets through to 2379/2380/8008/5432.
NODE_IPS=10.0.0.11,10.0.0.12,10.0.0.13
ETCD_HOSTS=10.0.0.11:2379,10.0.0.12:2379,10.0.0.13:2379
DB_HOSTS=10.0.0.11:5432,10.0.0.12:5432,10.0.0.13:5432
PUBLIC_URL=https://switchyard.example.com
# Networks hand-registered engines may live in besides their group's mgmt networks (comma-separated CIDRs), and
# secret paths every tenant may name (for example kv/se/ for shared Data Plane credentials). Leave empty if unused.
ENGINE_CIDRS=
SHARED_SECRET_PREFIXES=
# Never set in production: SWITCHYARD_INSECURE_AGENT=1, SWITCHYARD_ENGINE_POLICY=open, SWITCHYARD_SECRET_POLICY=open.
# Prometheus authenticates to /metrics and service discovery with this bearer token (same value on all nodes).
METRICS_TOKEN=change-me
# Grafana inside the UI (ADR 0085, runbooks/telemetry.md). Leave empty to keep only the plain link.
# GRAFANA_INTERNAL_URL: Grafana (http://host:3000), reachable from the controller nodes only.
# GRAFANA_DS_URL: how *Grafana* reaches a controller node's API port (never through the public front).
PROMETHEUS_URL=
LOKI_URL=
GRAFANA_INTERNAL_URL=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DS_URL=
# At least 32 random characters, the same on every node (openssl rand -hex 32):
GRAFANA_DS_SECRET=
# Mail server for email alert targets (docs/alerting.md); leave SMTP_HOST empty to use webhooks and chat only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=switchyard@example.com
# Directory with ca.crt, node.crt, node.key for etcd, Patroni's REST API and PostgreSQL (docs/production.md, "Securing the database tier").
PKI_DIR=./secrets/pki
# Password of Patroni's REST API (switchover, restart); the same on all nodes.
PATRONI_API_PASSWORD=change-me
# Docker network of the stack, admitted by pg_hba; change it if it overlaps your networks.
DOCKER_SUBNET=172.29.77.0/24
PG_SUPERUSER_PASSWORD=change-me
PG_REPLICATION_PASSWORD=change-me
# The ESXi member keeps etcd and Patroni but never becomes primary:
PATRONI_NOFAILOVER=false
BACKUP_REPO_TYPE=s3
BACKUP_S3_ENDPOINT=s3.example.com
BACKUP_S3_BUCKET=switchyard-backups
BACKUP_S3_KEY=change-me
BACKUP_S3_SECRET=change-me
# pgBackRest only speaks TLS to S3: y (default) verifies the endpoint certificate; n is for a lab with a self-signed one.
BACKUP_S3_VERIFY_TLS=y
BACKUP_CIPHER_PASS=change-me
BUNDLE_KEY_FILE=./secrets/bundle.key
# Directory with ca.crt, client.crt, client.key (controller client certificate from the OpenBao PKI):
MTLS_DIR=./secrets/mtls
# MTU of the Docker network the API, worker and proxy use; lower than the host NIC on an overlay (1500 is Docker's default).
DOCKER_MTU=1500
# Proxmox API for deploying and retiring engines (the token secret is in OpenBao at kv/proxmox/token).
PVE_URL=
PVE_TOKEN_ID=
PVE_CA_FILE=
PVE_NAME=pve
PVE_ADDR=127.0.0.1
