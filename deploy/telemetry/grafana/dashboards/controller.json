{
 "uid": "sy-controller",
 "title": "Switchyard controller",
 "tags": [
  "switchyard"
 ],
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Jobs by kind and state",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind,state) (switchyard_jobs)",
     "legendFormat": "{{kind}} {{state}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Job run time (average)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(switchyard_job_duration_seconds_sum[5m]) / clamp_min(rate(switchyard_job_duration_seconds_count[5m]), 1e-9)",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Change sets by state",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (state) (switchyard_change_sets)",
     "legendFormat": "{{state}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Engines reachable and drifted",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reachable) (switchyard_engines)",
     "legendFormat": "reachable={{reachable}}"
    },
    {
     "refId": "B",
     "expr": "sum(switchyard_engines_drifted)",
     "legendFormat": "drifted"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Drift findings",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(switchyard_drift_findings)",
     "legendFormat": "findings"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Age of newest status poll",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "switchyard_status_age_seconds",
     "legendFormat": "age"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 }
}