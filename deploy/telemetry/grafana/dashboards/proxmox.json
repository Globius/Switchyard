{
 "uid": "sy-proxmox",
 "title": "Proxmox",
 "tags": [
  "switchyard"
 ],
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Node CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "pve_cpu_usage_ratio{id=~\"node/.*\"}",
     "legendFormat": "{{id}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Node memory used",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "pve_memory_usage_bytes{id=~\"node/.*\"} / pve_memory_size_bytes{id=~\"node/.*\"}",
     "legendFormat": "{{id}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Guests running",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count by (type) (pve_up{id=~\"qemu/.*|lxc/.*\"} == 1)",
     "legendFormat": "{{type}}"
    },
    {
     "refId": "B",
     "expr": "count by (type) (pve_up{id=~\"qemu/.*|lxc/.*\"} == 0)",
     "legendFormat": "{{type}} stopped"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Guest CPU (top 10)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, pve_cpu_usage_ratio{id=~\"qemu/.*|lxc/.*\"} * on (id) group_left (name, type) pve_guest_info)",
     "legendFormat": "{{name}} ({{id}})"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Guest memory (top 10)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, pve_memory_usage_bytes{id=~\"qemu/.*|lxc/.*\"} * on (id) group_left (name, type) pve_guest_info)",
     "legendFormat": "{{name}} ({{id}})"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Storage used",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "pve_disk_usage_bytes{id=~\"storage/.*\"} / pve_disk_size_bytes{id=~\"storage/.*\"}",
     "legendFormat": "{{id}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Exporter and node reachability",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "pve_up{id=~\"node/.*\"}",
     "legendFormat": "{{id}}"
    }
   ]
  }
 ]
}