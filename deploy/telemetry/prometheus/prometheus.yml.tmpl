# @SCHEME@ and @HOSTPORT@ are filled in from the environment at start (see compose.yaml).
global:
  scrape_interval: 15s
  evaluation_interval: 30s
rule_files: [/etc/prometheus/rules.yml]
scrape_config_files: [/etc/prometheus/scrape.d/*.yml]
scrape_configs:
  - job_name: switchyard
    scheme: "@SCHEME@"
    authorization: { credentials_file: /etc/prometheus/switchyard-token }
    static_configs: [{ targets: ["@HOSTPORT@"] }]
  - job_name: se-haproxy
    authorization: { credentials_file: /etc/prometheus/switchyard-token }
    http_sd_configs:
      - url: "@SCHEME@://@HOSTPORT@/api/v1/discovery/prometheus?exporter=haproxy"
        authorization: { credentials_file: /etc/prometheus/switchyard-token }
        refresh_interval: 60s
  - job_name: se-node
    authorization: { credentials_file: /etc/prometheus/switchyard-token }
    http_sd_configs:
      - url: "@SCHEME@://@HOSTPORT@/api/v1/discovery/prometheus?exporter=node"
        authorization: { credentials_file: /etc/prometheus/switchyard-token }
        refresh_interval: 60s
