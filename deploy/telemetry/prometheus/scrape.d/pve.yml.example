# Copy to pve.yml (same directory) to scrape Proxmox through prometheus-pve-exporter (start it with
# `docker compose --profile pve up -d`). One target per cluster: any node's address works.
scrape_configs:
  - job_name: pve
    metrics_path: /pve
    params: { module: [default], cluster: ["1"], node: ["1"] }
    static_configs: [{ targets: ["pve1.example.test:8006"] }]
    relabel_configs:
      - { source_labels: [__address__], target_label: __param_target }
      - { source_labels: [__param_target], target_label: instance }
      - { target_label: __address__, replacement: pve-exporter:9221 }
