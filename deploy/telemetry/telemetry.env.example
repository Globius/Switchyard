# Where the controller VIP answers (host:port, no scheme) and how.
CONTROLLER_HOSTPORT=switchyard.example.com:443
CONTROLLER_SCHEME=https
GRAFANA_ADMIN_PASSWORD=change-me
# Grafana embedded in the UI (ADR 0085): the controller addresses allowed to send X-WEBAUTH-USER (Grafana refuses it from
# anywhere else; the default, loopback, trusts nobody), and the public address of the UI with /grafana/ (quickstart: https://<host>:8443/grafana/).
GRAFANA_PROXY_WHITELIST=10.0.0.11,10.0.0.12,10.0.0.13
GRAFANA_ROOT_URL=https://switchyard.example.com/grafana/
# Listen on all interfaces (default is loopback only):
BIND=0.0.0.0
PROM_RETENTION=30d
# Optional Proxmox metrics (`docker compose --profile pve up -d`, plus prometheus/scrape.d/pve.yml):
PVE_USER=monitor@pve
PVE_TOKEN_NAME=prometheus
PVE_TOKEN_VALUE=
PVE_VERIFY_SSL=true
# File holding SWITCHYARD_METRICS_TOKEN (only that value, no newline needed):
METRICS_TOKEN_FILE=./secrets/metrics.token
