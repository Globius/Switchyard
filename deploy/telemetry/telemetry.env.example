# Where the controller VIP answers (host:port, no scheme) and how.
CONTROLLER_HOSTPORT=switchyard.example.com:443
CONTROLLER_SCHEME=https
GRAFANA_ADMIN_PASSWORD=change-me
# Listen on all interfaces (default is loopback only):
BIND=0.0.0.0
PROM_RETENTION=30d
# Optional Proxmox metrics (`docker compose --profile pve up -d`, plus prometheus/scrape.d/pve.yml):
PVE_USER=monitor@pve
PVE_TOKEN_NAME=prometheus
PVE_TOKEN_VALUE=
PVE_VERIFY_SSL=true
# File holding SWITCHYARD_METRICS_TOKEN (only that value, no newline needed):
METRICS_TOKEN_FILE=./secrets/metrics.token
