# Template of the Data Plane API config. sy-render-dataplane writes /etc/switchyard/dataplaneapi.yml from it, with
# DP_USER and DP_PASSWORD from /etc/switchyard/agent/enroll.env (cloud-init). mTLS with the agent's certificate
# plus basic auth; the controller is the only client and reads the same credentials from its secret reference.
config_version: 2
name: switchyard-se
dataplaneapi:
  host: 0.0.0.0
  port: 5556            # plain listener disabled below; only the TLS listener answers
  scheme: [https]
  tls:
    tls_host: 0.0.0.0
    tls_port: 5556
    tls_certificate: /etc/switchyard/agent/tls.crt
    tls_key: /etc/switchyard/agent/tls.key
    tls_ca: /etc/switchyard/agent/ca.crt
  user:
    - name: "@DP_USER@"            # basic auth on top of mTLS; rendered per SE by sy-render-dataplane
      insecure: true
      password: "@DP_PASSWORD@"
  transaction:
    transaction_dir: /var/lib/dataplaneapi/transactions
  resources:
    maps_dir: /etc/switchyard/haproxy/maps
    ssl_certs_dir: /etc/switchyard/certs
    general_storage_dir: /etc/switchyard/haproxy/lists
    spoe_dir: /etc/haproxy/spoe
haproxy:
  config_file: /etc/switchyard/haproxy/haproxy.cfg
  haproxy_bin: /usr/sbin/haproxy
  reload:
    reload_delay: 1
    reload_cmd: systemctl reload haproxy
    restart_cmd: systemctl restart haproxy
    reload_strategy: custom
