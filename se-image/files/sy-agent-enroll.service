[Unit]
Description=Switchyard agent enrollment (one-time token from cloud-init)
After=network-online.target cloud-final.service
Wants=network-online.target
ConditionPathExists=/etc/switchyard/agent/enroll.token
ConditionPathExists=!/etc/switchyard/agent/tls.crt

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/switchyard/agent/enroll.env
ExecStart=/usr/local/bin/sy-agent enroll --controller ${CONTROLLER_URL} --token-file /etc/switchyard/agent/enroll.token --controller-ca /etc/switchyard/agent/controller-ca.crt
ExecStartPost=/bin/rm -f /etc/switchyard/agent/enroll.token
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
