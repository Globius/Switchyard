[Unit]
Description=Renew the Switchyard agent certificate
ConditionPathExists=/etc/switchyard/agent/renew.token

[Service]
Type=oneshot
EnvironmentFile=/etc/switchyard/agent/enroll.env
ExecStart=/usr/local/bin/sy-agent renew --controller ${CONTROLLER_URL} --controller-ca /etc/switchyard/agent/controller-ca.crt
ExecStartPost=/bin/systemctl try-restart sy-agent.service
