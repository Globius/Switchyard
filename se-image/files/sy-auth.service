[Unit]
Description=Switchyard auth sidecar (oauth2-proxy)
Documentation=https://github.com/oauth2-proxy/oauth2-proxy
After=network.target
# Runs only on engines that have an auth configuration: the agent writes /etc/switchyard/auth/ from the signed bundle,
# starts this unit when the first file appears and stops it when the last one is gone (agent/internal/bundle, ADR 0081).
ConditionPathExists=/etc/switchyard/auth/oauth2-proxy.cfg
ConditionPathExists=/usr/local/bin/oauth2-proxy

[Service]
User=sy-auth
Group=sy-auth
# The agent writes the files owner-only for root; systemd hands the service its own copy, so the sidecar needs no access
# to /etc/switchyard. Secrets (client secret, cookie secret) come as environment variables, never on the command line.
LoadCredential=oauth2-proxy.cfg:/etc/switchyard/auth/oauth2-proxy.cfg
EnvironmentFile=-/etc/switchyard/auth/secrets.env
ExecStart=/usr/local/bin/oauth2-proxy --config=%d/oauth2-proxy.cfg
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
MemoryMax=256M
TasksMax=256

[Install]
WantedBy=multi-user.target
