# Versions the SE image is built from. provision.sh and fetch-binaries.sh read this file; change a version here, rebuild
# the template, replace engines one at a time (docs/runbooks/build-se-template.md). ADR 0081.
HAPROXY_SERIES=3.2
DATAPLANE_IMAGE=haproxytech/haproxy-debian:3.2
GO_IMAGE=golang:1.26
# The auth sidecar slot (blocks P8/P9): oauth2-proxy, from its GitHub release. The checksum is verified by fetch-binaries.sh
# and again by provision.sh; update both when the version changes (the release publishes the sum next to the tarball).
OAUTH2_PROXY_VERSION=v7.15.5
OAUTH2_PROXY_SHA256_LINUX_AMD64=f63f94bf72c5f46ab002a0a275aa8b3cf19b4d828aed08a13978cb9a62c3a1fd
# The WAF sidecar slot (block P10): coraza-spoa has no binary releases, so fetch-binaries.sh builds this tag from source with
# the Go image (the Go module checksum database verifies it); the OWASP Core Rule Set is a source tarball pinned by SHA-256.
# The CRS version must be one the controller accepts (CRS_VERSIONS in controller/switchyard/domain/models.py).
CORAZA_SPOA_VERSION=v0.9.0
CRS_VERSION=4.8.0
CRS_SHA256=9a783c1de6b2a7447df254bfb2df37dd46b916cf766ed5f7e4a4cdf50fbc2478
